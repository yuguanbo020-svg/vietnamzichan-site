# Listing Desk v1 — copy this file to automation/.env and fill in real values.
# automation/.env must NEVER be committed (it holds a service-role key that bypasses
# all Row Level Security). Add it to .gitignore if it isn't already covered.

# Supabase project (Settings > API in the dashboard for project rpfccljejzfixohgwtpr).
SUPABASE_URL=https://rpfccljejzfixohgwtpr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-secret-key-here

# Local Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Public site URL used when building canonical links.
SITE_URL=https://vietnamzichan.com

# Set to 0 for a dry run: commits locally but does not push and does not mark
# rows PUBLISHED. Useful the first few times you run this by hand.
GIT_PUSH=1
